{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onsa",
  "version": "0.1.0",
  "identifier": "io.github.mufuyumoku.onsa",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "npm run build"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Onsa",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#161B26"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost onsa: http://onsa.localhost; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Music",
    "fileAssociations": [
      {
        "ext": ["flac", "mp3", "m4a", "m4b", "aac", "ogg", "oga", "wav", "wave", "aiff", "aif"],
        "name": "Onsa audio",
        "description": "Audio file",
        "role": "Viewer"
      }
    ],
    "shortDescription": "Onsa music player",
    "longDescription": "Onsa is a desktop music player that shows what is happening to the signal.",
    "linux": {
      "deb": {
        "depends": ["libasound2"]
      }
    }
  }
}
